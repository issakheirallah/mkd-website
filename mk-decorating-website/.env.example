# Copy this file to .env.local and fill in real values.
# In production set the same variables in Vercel → Project → Settings → Environment Variables.

# Formspree endpoint for the contact form.
# Sign up at https://formspree.io/, create a form, then paste the URL here.
# Without this, the form falls back to opening the visitor's mail client (mailto).
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_WITH_YOUR_ID

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Get this from https://analytics.google.com → Admin → Data Streams → Web.
# Analytics only fire after the visitor accepts the cookie banner.
VITE_GA_ID=G-XXXXXXXXXX
